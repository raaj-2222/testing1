# Copy this file to .env. In local development, verification links print in terminal.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# Production with a persistent volume: DB_PATH=/data/cabshare.sqlite
# DB_PATH=./data/cabshare.sqlite
# Every @vjti.ac.in address AND any branch/faculty subdomain of vjti.ac.in is accepted.
# VJTI is always included; this optional setting may add other explicitly approved domains.
ALLOWED_EMAIL_DOMAINS=vjti.ac.in
# Preferred on Vercel: HTTPS transactional email with a verified sending domain.
# RESEND_API_KEY=re_your_secret_key
# MAIL_FROM="CabShare <verify@your-verified-domain.example>"
# Or use SMTP for a traditional Node server (never commit real credentials):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account
# SMTP_PASS=your-app-password
# MAIL_FROM="CabShare <no-reply@example.com>"
# TRUST_PROXY=1   # set only behind a trusted reverse proxy

# On Vercel, local SQLite storage is ephemeral/read-only; move DB to a durable host.
# See docs/VERCEL_SETUP.md (email provider setup + database requirement).
